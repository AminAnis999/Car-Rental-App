@model List<CarRentalApp.Models.Car>

@{
    ViewData["Title"] = "Available Cars";
}

<div class="mb-4">
    <h2 class="fw-bold">Available Cars</h2>

    <p class="text-muted">
        Select a car below and click Book Car to reserve it.
    </p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No cars are currently available.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var car in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column p-4">

                        <h5 class="card-title fw-bold">
                            @car.Name
                        </h5>

                        <p class="card-text fs-5 mb-3">
                            PKR @car.PricePerDay.ToString("N0")
                            <small class="text-muted">/ day</small>
                        </p>

                        <div class="mb-4">
                            <span class="badge bg-success">
                                Available
                            </span>
                        </div>

                        <form asp-controller="Cars"
                              asp-action="Book"
                              method="post"
                              class="mt-auto">

                            <input type="hidden"
                                   name="id"
                                   value="@car.Id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Book Car
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        }

    </div>
}